{
  "name": "dutygate-client",
  "version": "0.1.0",
  "description": "TypeScript client for the DutyGate sidecar: flag legal and compliance triggers before a chatbot replies.",
  "license": "MIT",
  "author": "Taimoor Rashid",
  "homepage": "https://github.com/Taimoor2500/Dutygate/tree/main/clients/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taimoor2500/Dutygate.git",
    "directory": "clients/typescript"
  },
  "keywords": ["chatbot", "compliance", "legal", "guardrail", "dutygate"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "DUTYGATE_E2E=1 vitest run test/conformance.e2e.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
